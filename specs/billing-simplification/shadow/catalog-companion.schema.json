{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_type",
    "source_version",
    "frozen_export_sha256",
    "stripe_scope",
    "application_key",
    "application_ownership_revision",
    "price_ownership_revision",
    "application_state_digest",
    "price_id",
    "product_id",
    "billing_interval",
    "retrieved_at",
    "request",
    "provider_response",
    "checksum"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source_type": {
      "const": "stripe_test_price_retrieve"
    },
    "source_version": {
      "const": 1
    },
    "frozen_export_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stripe_scope": {
      "const": "acct_1OoTzlG71GpCYtA4:test"
    },
    "application_key": {
      "const": "dmi_cards"
    },
    "application_ownership_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "price_ownership_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "application_state_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "price_id": {
      "type": "string",
      "pattern": "^price_[A-Za-z0-9]+$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^prod_[A-Za-z0-9]+$"
    },
    "billing_interval": {
      "enum": [
        "monthly",
        "annual"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "account_id",
        "price_id",
        "request_id"
      ],
      "properties": {
        "method": {
          "const": "GET"
        },
        "account_id": {
          "const": "acct_1OoTzlG71GpCYtA4"
        },
        "price_id": {
          "type": "string",
          "pattern": "^price_[A-Za-z0-9]+$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^req_[A-Za-z0-9]+$"
        }
      }
    },
    "provider_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "id",
        "product",
        "livemode",
        "active",
        "recurring"
      ],
      "properties": {
        "object": {
          "const": "price"
        },
        "id": {
          "type": "string",
          "pattern": "^price_[A-Za-z0-9]+$"
        },
        "product": {
          "type": "string",
          "pattern": "^prod_[A-Za-z0-9]+$"
        },
        "livemode": {
          "const": false
        },
        "active": {
          "const": true
        },
        "recurring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interval",
            "interval_count"
          ],
          "properties": {
            "interval": {
              "enum": [
                "month",
                "year"
              ]
            },
            "interval_count": {
              "const": 1
            }
          }
        }
      }
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
