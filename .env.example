# Public lead capture abuse protection
# Use a Redis-compatible REST endpoint such as Upstash Redis or Vercel Redis/KV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PUBLIC_LEAD_RATE_LIMIT_SECRET=

# Optional tuning. Defaults are intentionally conservative and can be adjusted
# without changing application code.
PUBLIC_LEAD_RATE_LIMIT_IP_CARD_PER_MINUTE=5
PUBLIC_LEAD_RATE_LIMIT_IP_CARD_PER_HOUR=25
PUBLIC_LEAD_RATE_LIMIT_IP_GLOBAL_PER_MINUTE=30
PUBLIC_LEAD_RATE_LIMIT_CARD_GLOBAL_PER_MINUTE=120
PUBLIC_LEAD_RATE_LIMIT_PLATFORM_GLOBAL_PER_MINUTE=1500
PUBLIC_LEAD_RATE_LIMIT_SUSPICIOUS_IP_CARD_PER_MINUTE=2
PUBLIC_LEAD_RATE_LIMIT_SUSPICIOUS_CARD_PER_MINUTE=30
PUBLIC_LEAD_MIN_FORM_TIME_MS=800
PUBLIC_LEAD_RATE_LIMIT_TIMEOUT_MS=400
PUBLIC_LEAD_RATE_LIMIT_FAIL_OPEN=false

# Email Automations OAuth connections
# Generate EMAIL_TOKEN_ENCRYPTION_KEY as a 32-byte base64 or 64-character hex value.
EMAIL_TOKEN_ENCRYPTION_KEY=
EMAIL_OAUTH_STATE_SECRET=
GOOGLE_EMAIL_CLIENT_ID=
GOOGLE_EMAIL_CLIENT_SECRET=
MICROSOFT_EMAIL_CLIENT_ID=
MICROSOFT_EMAIL_CLIENT_SECRET=
MICROSOFT_EMAIL_TENANT=common
